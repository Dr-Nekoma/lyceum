%% == Compiler & other options ==
{erl_opts, [
    warn_unused_import,
    warn_export_vars,
    warnings_as_errors,
    verbose,
    report,
    debug_info,
    {i, "./include"}
]}.

{dist_node, [
    {setcookie, 'lyceum'},
    {sname, 'lyceum_server'}
]}.

%% == Dependencies and Plugins ==
{deps, [
    {pc, "1.15.0"},
    {erlandono, "3.1.3"},
    {migraterl, "0.5.0"},
    {csv, "3.0.4", {pkg, csve}}
]}.

{plugins, [
    {rebar3_nix, ".*", {git, "https://github.com/erlang-nix/rebar3_nix.git", {tag, "v0.1.1"}}},
    {covertool, "v2.0.4"}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_opts, [verbose]}.
{covertool, [
    {coverdata_files, [
        "ct.coverdata",
        "eunit.coverdata"
    ]}
]}.

%% == Common Test ==
{ct_opts, []}.

%% == Releases ==
{relx, [
    {release, {lyceum, "0.2.3"}, [
        pgo,
        epgsql,
        erlandono,
        {migraterl, load},
        {lyceum_cluster, permanent},
        {database, permanent},
        {lib_map, permanent},
        cache,
        {lyceum_service, permanent},
        world,
        player,
        auth,
        sasl
    ]},

    {mode, dev},
    {extended_start_script, true},

    %% The .src forms are substituted from the environment at every
    %% start (no RELX_REPLACE_OS_VARS needed), which is what lets one
    %% release boot as a frontend, logic or service node: see
    %% LYCEUM_NODE_NAME / LYCEUM_NODE_TYPES / LYCEUM_PEERS in
    %% config/vm.args.src and config/sys.config.src.
    {sys_config_src, "./config/sys.config.src"},
    {vm_args_src, "./config/vm.args.src"},

    {overlay, [
        {mkdir, "log/sasl"},
        {mkdir, "log/errors"},
        {mkdir, "database/migrations"},
        {mkdir, "database/queries"},
        {copy, "maps/*", "\{\{output_dir\}\}/maps/"},
        {copy, "database/migrations/*", "\{\{output_dir\}\}/database/migrations/"},
        {copy, "database/queries/*", "\{\{output_dir\}\}/database/queries/"}
    ]}
]}.

%% == Shell ==
%% apps to auto-boot with `rebar3 shell'; defaults to apps
%% specified in a `relx' tuple, if any.
{shell, [
    {config, "config/shell.config"},
    {apps, [
        kernel,
        stdlib,
        sasl,
        pgo,
        {migraterl, load},
        {lyceum_cluster, permanent},
        {database, permanent},
        {lib_map, permanent},
        cache,
        {lyceum_service, permanent},
        world,
        player,
        auth
    ]}
    %%{script_file, "shell_setup.escript"}
    %%{env_file, "deployment/default.env"}]
]}.

%% == Profiles ==
{profiles, [
    %% prod is the default mode when prod
    %% profile is used, so does not have
    %% to be explicitly included like this
    {prod, [
        {relx, [
            {include_erts, true},
            {sys_config_src, "./config/sys.config.src"},
            {vm_args_src, "./config/vm.args.src"},
            %% https://rebar3.org/docs/deployment/releases/#modes
            {mode, prod}
        ]}
    ]},

    {test, [
        {deps, [meck, proper]}
    ]},

    %% Local multi-node development. Never part of a release: braid
    %% launches bare `erl` nodes for `just cluster`, which is a
    %% developer convenience, not something a deployment runs.
    {dev, [
        {deps, [{braid, "1.0.1"}]},
        {extra_src_dirs, ["dev"]}
    ]}
]}.

%% == Directories ==
{project_app_dirs, ["apps/*", "include/*", "."]}.

%% == Dialyzer ==
{dialyzer, [
    {warnings, [
        % Basic Warnings
        no_return,
        no_unused,
        no_improper_lists,
        no_fun_app,
        no_match,
        no_opaque,
        no_fail_call,
        no_contracts,
        no_behaviours,
        no_undefined_callbacks,

        % Additional Stuff
        unmatched_returns,
        error_handling,
        no_underspecs,
        no_unknown
    ]},

    {plt_apps, top_level_deps},
    {exclude_mods, []},
    % Output configuration
    {output_format, formatted}
]}.

%% == Escript ==
